# ---- Required ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SESSION_SECRET=generate-a-long-random-secret
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...

# ---- Browser notifications (run: python generate_vapid_keys.py) ---------------
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Your admin account (created/promoted at startup; works without a shell) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- External scheduler hook: lets cron-job.org / GitHub Actions run the deadline
# ---- check and wake the app. Use a long random value. Leave empty to disable.
CRON_SECRET=

# ---- Optional ---------------------------------------------------------------
SESSION_HTTPS_ONLY=true
TRUSTED_PROXY_HOPS=1        # proxies in front of the app (Render = 1; 0 when running locally)
DEADLINE_HOURS=24
ALERT_REPEAT_MINUTES=60     # re-alert interval while overdue
TODO_REMINDER_HOURS=4       # how often to remind about unfinished tasks
TICK_MINUTES=5              # in-app deadline check interval
REGISTRATION_OPEN=true      # initial default; the admin page toggle overrides it
SESSION_MAX_AGE_SECONDS=43200
