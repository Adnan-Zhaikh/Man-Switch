DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SESSION_SECRET=generate-a-long-random-secret
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...

# Push alerts (python generate_vapid_keys.py)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Owner account, created at startup
ADMIN_USERNAME=
ADMIN_PASSWORD=

# External scheduler hook (/internal/tick)
CRON_SECRET=

# Calendar email reminders: set ONE provider. EMAIL_FROM must be verified with it.
EMAIL_FROM=you@example.com
EMAIL_FROM_NAME=Man Switch
BREVO_API_KEY=
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# APP_URL=https://your-app.onrender.com
# EVENT_REMINDER_MINUTES=60

# Production
# SESSION_HTTPS_ONLY=true
# TRUSTED_PROXY_HOPS=1

# Tuning
# DEADLINE_HOURS=24
# ALERT_REPEAT_MINUTES=60
# TICK_MINUTES=5
# TODO_REMINDER_HOURS=4
# REGISTRATION_OPEN=true
